# Copy this file to `.env` and fill in the values for your sale.

# Change this to match your Sonar sale credentials
# You can find these UUIDs under the integration tab on your Sonar sale dashboard
VITE_SALE_UUID=575ae869-c46c-41d1-a7ed-d726fa3eabe2
VITE_OAUTH_CLIENT_UUID=adf210ee-50c7-43e6-8d86-62609b33d3d0

# Must match a redirect URI configured for your sale's oauth client on the Sonar founder dashboard
VITE_OAUTH_CLIENT_REDIRECT_URI=http://localhost:3000/oauth/callback

# Address of the payment token, e.g. USDC. Use the mainnet mint when running on mainnet.
VITE_PAYMENT_TOKEN_MINT="11111111111111111111111111111111"

# DANGER! Exposing an RPC URL on the frontend allows anyone to extract and use your private RPC keys.
# Only use scoped and rate-limited API keys, never expose your master private keys.
# Not setting this will use the public Solana devnet RPC endpoint.
# Set this to a mainnet RPC endpoint (together with VITE_PROGRAM_ID) to run on mainnet.
# VITE_RPC_URL=https://api.devnet.solana.com

# Address of the SettlementSale program.
# Not setting this will use the devnet program from the shared IDL (3XxHCh947y1PAMK5y8oecBtaLU7TtTj9r4yMYwzFbJYs).
# Set this to the mainnet program address (together with VITE_RPC_URL) to run on mainnet.
# VITE_PROGRAM_ID=3XxHCh947y1PAMK5y8oecBtaLU7TtTj9r4yMYwzFbJYs
